[Unit]
Description=PostgreSQL backup freshness and capacity monitor
RequiresMountsFor=/mnt/nvme-ssd/postgres-backups/automated
OnFailure=postgresql-backup-critical@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
Environment=PATH=/usr/lib/postgresql/16/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NEM_BACKUP_TESTING=0
UnsetEnvironment=NEM_BACKUP_TEST_ROOT NEM_BACKUP_CONFIG NEM_BACKUP_NOW NEM_BACKUP_EPOCH
ExecStart=/usr/local/libexec/nem-postgresql-backup/monitor.sh
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadOnlyPaths=/mnt/nvme-ssd/postgres/main /mnt/nvme-ssd/postgres-backups/automated /etc/postgresql/16/main /etc/nem/postgresql-backup.conf

[Install]
WantedBy=multi-user.target
